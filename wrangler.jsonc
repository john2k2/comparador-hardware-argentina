{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "custom-worker.mjs",
	"name": "comparador-hardware-argentina",
	"workers_dev": true,
	"preview_urls": true,
	"keep_vars": true,
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"vars": {
		"DISABLE_INTERNAL_BACKGROUND_REFRESH": "1",
		"DISABLE_LIVE_SCRAPING": "1",
		"ENABLE_ON_DEMAND_REFRESH": "1",
		"CATALOG_REQUESTED_RUNNER": "0",
		"CATALOG_SCHEDULER_ENABLED": "1",
		"MEASUREMENT_COLLECTION_MODE": "external",
		"MEASUREMENT_PUBLIC_URL": "https://www.comparador-hardware.com.ar",
		"MEASUREMENT_GOOGLE_CLIENT_TYPE": "installed",
		"ENEBA_AFFILIATE_PILOT_ENABLED": "1"
	},
	"triggers": { "crons": ["11 * * * *"] },
	"compatibility_date": "2026-09-05",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	},
	"assets": {
		"directory": ".open-next/assets",
		"run_worker_first": ["/__public-documents/*"],
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "comparador-hardware-argentina"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"routes": [
		{ "pattern": "comparador-hardware.com.ar", "custom_domain": true },
		{ "pattern": "www.comparador-hardware.com.ar", "custom_domain": true }
	],
}
