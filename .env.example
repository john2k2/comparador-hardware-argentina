# ============================================
# Variables de Entorno - Comparador Hardware
# ============================================
# Copiar este archivo a .env.local y completar los valores

# ============================================
# SUPABASE (Requeridas)
# ============================================

# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (usada por el cliente)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key
SUPABASE_PUBLISHABLE_KEY=tu-publishable-key

# Clave secreta (SOLO para uso server-side)
# NUNCA expongas esta clave en el cliente
SUPABASE_SECRET_KEY=tu-secret-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_ANON_KEY=tu-anon-key

# Clave de servicio (SOLO para migraciones y operaciones privileged)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ============================================
# SITIO (Requeridas para SEO)
# ============================================

# URL canonical del sitio (sin slash al final)
SITE_URL=https://www.comparador-hardware.com.ar

# Token de verificación de Google Search Console
# Obtener desde: https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=tu-token-de-verificacion

# Email de soporte
SUPPORT_EMAIL=contacto@comparador-hardware.com.ar

# ============================================
# CLOUDFLARE (Opcional - para PortalTech)
# ============================================

CLOUDFLARE_API_TOKEN=tu-cloudflare-token
CLOUDFLARE_ACCOUNT_ID=tu-cloudflare-account-id

# ============================================
# CRON / SCHEDULER (Opcional)
# ============================================

# Secreto para firmar refresh interno (bypassDb). Si falta, se usa CATALOG_REFRESH_CRON_SECRET o CRON_SECRET.
# El header x-internal-refresh ya no acepta el valor "1".
INTERNAL_REFRESH_SECRET=tu-internal-refresh-secret-min-32-chars

# Secreto para endpoints de cron (debe ser seguro, min 32 caracteres)
CRON_SECRET=tu-cron-secret-seguro-min-32-chars

# Secreto específico para refresh de catálogo
CATALOG_REFRESH_CRON_SECRET=tu-catalog-refresh-secret

# Desactivar refresh interno (1 = disabled)
# DISABLE_INTERNAL_BACKGROUND_REFRESH=1

# En producción el catálogo público se sirve desde datos persistidos. Habilitar
# scraping durante una visita sólo como medida temporal de diagnóstico.
# ENABLE_PUBLIC_LIVE_SCRAPING=1

# Actualización de las ofertas elegidas en el armador. Aplicar primero la migración
# 20260922010000_requested_offer_refresh.sql y habilitar la misma variable en Actions.
ENABLE_ON_DEMAND_REFRESH=0
# Token GitHub de alcance mínimo para el repositorio: permiso Actions (write).
# El Worker lo usa sólo para despachar requested-offer-refresh.yml al aceptar
# una solicitud; sin él, la cola depende del schedule de recuperación.
GITHUB_ACTIONS_DISPATCH_TOKEN=
# Sólo para el proceso Node que consume la cola en GitHub Actions. Mantener 0 en Workers.
CATALOG_REQUESTED_RUNNER=0

# ============================================
# JEV / CALIDAD DE OFERTAS (Opcional, sólo servidor)
# ============================================
# Aplicar primero 20260922000000_offer_identity_review.sql.
# No usar NEXT_PUBLIC_ para la clave. Se consulta sólo en refresh autenticado.
TYPESAFE_API_KEY=
ENABLE_JEV_OFFER_REVIEW=0
# Límite fijo: 16 ofertas por consulta de refresh, lotes de 8 y 3s por llamada; caché de 24h.

# ============================================
# ANALYTICS (Opcional)
# ============================================

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# LOGGING (Opcional)
# ============================================

# Nivel de log (debug, info, warn, error)
LOG_LEVEL=info
NEXT_PUBLIC_LOG_LEVEL=warn

# ============================================
# FEATURES (Opcional)
# ============================================

# IDs de tiendas sponsor (separados por coma)
NEXT_PUBLIC_SPONSORED_STORE_IDS=mexx,venex

# ============================================
# VERIFICACIÓN
# ============================================
# Para verificar que todo funciona:
# 1. npm run build
# 2. npm run lint
# 3. npm test
