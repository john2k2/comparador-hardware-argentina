[Unit]
Description=Respaldo privado del catálogo del comparador
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/comparador-catalog-backup
User=root
Group=root
UMask=0077
Environment=DOCKER_CONFIG=/opt/comparador-catalog/docker-config
TimeoutStartSec=15min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/comparador-catalog/backups /run/lock
